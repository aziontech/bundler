{
  "name": "bundler",
  "version": "0.0.0",
  "description": "Tool to launch and build JavaScript/Frameworks. This tool automates polyfills for Edge Computing and assists in creating Workers, notably for the Azion platform.",
  "private": true,
  "scripts": {
    "prepare": "husky install",
    "build": "pnpm -r --if-present build",
    "lint": "pnpm -r --if-present lint",
    "lint:fix": "pnpm -r --if-present lint:fix",
    "format": "pnpm -r --if-present format",
    "format:check": "pnpm -r --if-present format:check",
    "test": "pnpm -r --if-present --workspace-concurrency=1 test"
  },
  "author": "aziontech",
  "license": "MIT",
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.1",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "pkg-pr-new": "^0.0.88",
    "ts-node": "^10.9.2",
    "typescript-eslint": "^8.68.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "pnpm": {
    "overrides": {
      "postcss": ">=8.5.18",
      "fast-uri": ">=3.1.4",
      "minimatch@3>brace-expansion": ">=1.1.17",
      "minimatch@9>brace-expansion": ">=2.1.3",
      "minimatch@10>brace-expansion": ">=5.0.8"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aziontech/bundler.git"
  },
  "bugs": {
    "url": "https://github.com/aziontech/bundler/issues"
  },
  "homepage": "https://github.com/aziontech/bundler#readme"
}
