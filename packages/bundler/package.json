{
  "name": "@aziontech/bundler",
  "version": "1.1.4",
  "description": "Tool to launch and build JavaScript/Frameworks. This tool automates polyfills for Edge Computing and assists in creating Workers, notably for the Azion platform.",
  "index": "dist/index.js",
  "module": "dist/index.js",
  "type": "module",
  "bin": {
    "azbundler": "dist/index.js",
    "azion-bundler": "dist/index.js",
    "azb": "dist/index.js"
  },
  "scripts": {
    "build": "vite build",
    "task:reports": "node tasks/process-reports-e2e.js",
    "task:reports-nodejs-apis": "node tasks/process-reports-nodejs-apis.js",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "test": "jest --clearCache && NODE_OPTIONS='--experimental-vm-modules' jest --maxWorkers 1 -c jest.config.ts",
    "test:watch": "jest lib/ --watch",
    "test:coverage": "jest --clearCache && jest lib/ --coverage",
    "format:check": "prettier . --check",
    "e2e:start": "pnpm submodule:update && tests/scripts/start-e2e-env.sh",
    "e2e:stop": "tests/scripts/stop-e2e-env.sh",
    "e2e:destroy": "tests/scripts/destroy-e2e-env.sh",
    "test:e2e": "pnpm e2e:start && NODE_OPTIONS='--experimental-vm-modules' jest --detectOpenHandles --forceExit --runInBand --config=./jest-e2e.config.js tests/e2e/ --json --outputFile e2e_results.json; TEST_EXIT_CODE=$?; pnpm e2e:stop; pnpm task:reports; exit $TEST_EXIT_CODE",
    "test:nodejs-apis": "pnpm e2e:start && NODE_OPTIONS='--experimental-vm-modules' jest --forceExit --runInBand --config=./jest-e2e.config.js tests/nodejs-apis/ --json --outputFile nodejs_apis_results.json; TEST_EXIT_CODE=$?; pnpm e2e:stop; pnpm task:reports-nodejs-apis; exit $TEST_EXIT_CODE",
    "submodule:update": "git submodule update --init --recursive && git submodule foreach git pull origin main"
  },
  "author": "aziontech",
  "license": "MIT",
  "dependencies": {
    "@aziontech/builder": "1.0.5",
    "@aziontech/bundler-telemetry": "1.0.0",
    "@aziontech/config": "1.0.2",
    "@aziontech/presets": "1.1.2",
    "@aziontech/utils": "1.0.0",
    "@edge-runtime/primitives": "6.0.0",
    "@netlify/framework-info": "^10.0.5",
    "chokidar": "^5.0.0",
    "commander": "^15.0.0",
    "cosmiconfig": "^10.0.1",
    "cosmiconfig-typescript-loader": "^6.1.0",
    "edge-runtime": "^4.0.1",
    "lodash": "^4.17.21",
    "prettier": "^3.3.2",
    "semver": "^7.5.2",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "@aziontech/types": "1.0.0",
    "@jest/globals": "^30.5.0",
    "@swc/core": "^1.16.1",
    "@swc/jest": "^0.2.39",
    "@types/inquirer": "^9.0.7",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.16",
    "@types/mock-fs": "^4.13.4",
    "@types/semver": "^7.5.8",
    "@types/tmp": "^0.2.6",
    "globals": "^17.11.0",
    "jest": "^30.5.0",
    "mock-fs": "^5.2.0",
    "puppeteer": "^25.9.0",
    "supertest": "^7.2.2",
    "tmp": "^0.2.6",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "vite": "^8.2.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aziontech/bundler.git",
    "directory": "packages/bundler"
  },
  "bugs": {
    "url": "https://github.com/aziontech/bundler/issues"
  },
  "homepage": "https://github.com/aziontech/bundler#readme",
  "files": [
    "dist",
    "package.json",
    "README.md"
  ]
}
